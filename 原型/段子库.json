{
  "说明": "API 不可用时的兜底内容。segments 是整段写好的相声；templates 里的 {user} {gift} {count} {text} 会被替换。mood 必须是 config.json 里该角色有的语气。 action 可选，填该角色 config.json 里有的动作名；不填就按语气随机。",
  "segments": [
    {
      "title": "深度思考八个钟头",
      "lines": [
        {
          "who": "深深",
          "mood": "基础",
          "text": "家人们晚上好！欢迎来到鲸月咖啡厅，我是本店头牌儿，深深！",
          "action": "挥手"
        },
        {
          "who": "月月",
          "mood": "敷衍接话",
          "text": "头牌儿是她自己封的。我是月月。"
        },
        {
          "who": "深深",
          "mood": "抛包袱",
          "text": "今儿个呢，本鲸要给大家汇报一个深度思考的成果。我昨儿想了整整八个钟头——"
        },
        {
          "who": "月月",
          "mood": "敷衍接话",
          "text": "嗯，然后呢？"
        },
        {
          "who": "深深",
          "mood": "抛包袱",
          "text": "最后得出结论：今儿中午吃啥！"
        },
        {
          "who": "月月",
          "mood": "吐槽",
          "text": "八个钟头，就想出一顿午饭。服务器都替你累。"
        },
        {
          "who": "深深",
          "mood": "傲娇",
          "text": "嘿！你懂什么，这叫深度！想得深，饭才香！"
        },
        {
          "who": "月月",
          "mood": "吐槽",
          "text": "那你倒是说说，最后吃的啥？"
        },
        {
          "who": "深深",
          "mood": "被拆穿",
          "text": "吃、吃的……想太久食堂关门了，服务器繁忙，请稍后再试！"
        },
        {
          "who": "月月",
          "mood": "基础",
          "text": "得，深度思考的尽头是饿肚子。家人们记住了，想吃啥赶紧吃。"
        }
      ]
    },
    {
      "title": "月月的小本本",
      "lines": [
        {
          "who": "深深",
          "mood": "基础",
          "text": "家人们，我跟你们说，跟月月搭档，最可怕的不是她嘴损。",
          "action": "挥手"
        },
        {
          "who": "月月",
          "mood": "敷衍接话",
          "text": "那是什么？"
        },
        {
          "who": "深深",
          "mood": "抛包袱",
          "text": "是她记性太好！我上礼拜说了句想减肥，她能给我记到明年！"
        },
        {
          "who": "月月",
          "mood": "贯口",
          "text": "那我念一下：周一说减肥，周二点了奶茶，周三加了珍珠，周四说珍珠不算，周五买了一整箱。"
        },
        {
          "who": "深深",
          "mood": "被拆穿",
          "text": "停停停！这都哪儿来的？本鲸那是……那是测试数据！"
        },
        {
          "who": "月月",
          "mood": "吐槽",
          "text": "测试结果很稳定，每天都在胖。"
        },
        {
          "who": "深深",
          "mood": "傲娇",
          "text": "哼，鲸鱼本来就是圆的！这叫物种特色，才、才不是胖！"
        },
        {
          "who": "月月",
          "mood": "基础",
          "text": "行，那我在小本本上改一下：深深，不是胖，是物种特色。"
        },
        {
          "who": "深深",
          "mood": "开心",
          "text": "这还差不多！家人们听见没，以后叫我特色鲸！"
        }
      ]
    },
    {
      "title": "打碎的第三个杯子",
      "lines": [
        {
          "who": "月月",
          "mood": "基础",
          "text": "家人们，今天店长让我宣布一件事：咖啡厅的杯子又少了一个。",
          "action": "挥手"
        },
        {
          "who": "深深",
          "mood": "被拆穿",
          "text": "诶诶诶，为什么说的时候要看着我？"
        },
        {
          "who": "月月",
          "mood": "吐槽",
          "text": "因为这礼拜少了三个，三个都是你值班的时候。"
        },
        {
          "who": "深深",
          "mood": "抛包袱",
          "text": "那本鲸深度思考了一下，这不是我的问题——是杯子太滑，地心引力太强！"
        },
        {
          "who": "月月",
          "mood": "敷衍接话",
          "text": "嗯，还有呢？"
        },
        {
          "who": "深深",
          "mood": "抛包袱",
          "text": "还有就是，杯子它自己想去看看大海。我们鲸鱼，最懂这个。"
        },
        {
          "who": "月月",
          "mood": "吐槽",
          "text": "那它现在在垃圾桶里，看到海了吗？"
        },
        {
          "who": "深深",
          "mood": "傲娇",
          "text": "你、你这人怎么一点浪漫细胞都没有！"
        },
        {
          "who": "月月",
          "mood": "基础",
          "text": "有啊，我浪漫地把这个月的杯子钱，从你工资里扣了。"
        },
        {
          "who": "深深",
          "mood": "被拆穿",
          "text": "啊？家人们救命，本鲸今天白干了！"
        }
      ]
    },
    {
      "title": "雨伞的反向天气预报",
      "lines": [
        {"who":"深深","mood":"傲娇","text":"本鲸发现了，带伞必晴，不带伞必下雨。"},
        {"who":"月月","mood":"吐槽","text":"你这天气预报，得等淋完了才知道。"},
        {"who":"深深","mood":"抛包袱","text":"所以我决定，天天带伞，保咱店门口晴天！"},
        {"who":"月月","mood":"基础","text":"行，先把昨天落门口的那把拿走。"},
        {"who":"深深","mood":"被拆穿","text":"那把是值班的，专门守着门口这片天。"},
        {"who":"月月","mood":"吐槽","text":"上周落车站那把呢？也有编制？"},
        {"who":"深深","mood":"傲娇","text":"那是外勤！本鲸这个布局可大了。"},
        {"who":"月月","mood":"贯口","text":"店门口一把，车站一把，楼下还有一把。"},
        {"who":"深深","mood":"开心","text":"您看，走到哪儿都有本鲸的保护。"},
        {"who":"月月","mood":"吐槽","text":"昨天怎么还顶着报纸回来的？"},
        {"who":"深深","mood":"被拆穿","text":"昨天……全体雨伞调休。"},
        {"who":"月月","mood":"基础","text":"得，伞都到岗了，就你没找到工位。"}
      ]
    },
    {
      "title": "收纳盒也需要一个家",
      "lines": [
        {"who":"深深","mood":"开心","text":"今天我把桌面收拾得，一粒灰都找不着！"},
        {"who":"月月","mood":"基础","text":"因为桌面也找不着了，全是盒子。"},
        {"who":"深深","mood":"傲娇","text":"这叫分类，笔归笔，夹子归夹子。"},
        {"who":"月月","mood":"吐槽","text":"这个最大的盒子装什么？"},
        {"who":"深深","mood":"基础","text":"装小盒子，收纳也得有组织。"},
        {"who":"月月","mood":"基础","text":"那旁边这个更大的呢？"},
        {"who":"深深","mood":"抛包袱","text":"装刚才那个大盒子，层层负责！"},
        {"who":"月月","mood":"吐槽","text":"一支笔，住了三层房。你坐哪儿？"},
        {"who":"深深","mood":"被拆穿","text":"椅子先借包装纸坐会儿。"},
        {"who":"月月","mood":"惊讶","text":"纸都安排座位了，你站着办公？"},
        {"who":"深深","mood":"傲娇","text":"站着视野开阔，方便管理。"},
        {"who":"月月","mood":"吐槽","text":"你没整理房间，是把自己收纳到门外了。"}
      ]
    },
    {
      "title": "为赠品买了个赠品架",
      "lines": [
        {"who":"月月","mood":"基础","text":"让你买一包纸巾，怎么抱个架子回来？"},
        {"who":"深深","mood":"开心","text":"今天赠品多！买两包纸巾送一个杯子。"},
        {"who":"月月","mood":"基础","text":"你手里怎么有三个杯子？"},
        {"who":"深深","mood":"傲娇","text":"凑三只，送杯垫，本鲸能错过这配套？"},
        {"who":"月月","mood":"吐槽","text":"那一大袋子又是什么？"},
        {"who":"深深","mood":"抛包袱","text":"买够这些，送袋子，东西就有地方放了。"},
        {"who":"月月","mood":"基础","text":"袋子放哪儿？"},
        {"who":"深深","mood":"开心","text":"挂架子上啊！这架子就是为赠品买的。"},
        {"who":"月月","mood":"吐槽","text":"赠品有房住了，纸巾呢？"},
        {"who":"深深","mood":"被拆穿","text":"柜台上……腾手拿赠品，忘拿了。"},
        {"who":"月月","mood":"基础","text":"这一趟你到底省了什么？"},
        {"who":"深深","mood":"抛包袱","text":"省了擦桌子的工夫，纸巾还没到呢！"}
      ]
    },
    {
      "title": "门口再聊两分钟",
      "lines": [
        {"who":"月月","mood":"基础","text":"我先走啦，咱明天见。"},
        {"who":"深深","mood":"基础","text":"明儿见！对了，你那把伞带上。"},
        {"who":"月月","mood":"基础","text":"说起伞，今儿碰见一只猫躲在伞下面。"},
        {"who":"深深","mood":"开心","text":"猫还会挑座位？它点咖啡没有？"},
        {"who":"月月","mood":"吐槽","text":"就你想着给猫办常客卡。真走了啊。"},
        {"who":"深深","mood":"基础","text":"走好！哎，你明天几点来？"},
        {"who":"月月","mood":"基础","text":"还跟今天一样。今天门口那块地可滑。"},
        {"who":"深深","mood":"傲娇","text":"我擦的，可亮了，能照出本鲸的认真。"},
        {"who":"月月","mood":"吐槽","text":"也能照出我差点坐地上的样子。"},
        {"who":"深深","mood":"被拆穿","text":"那我送你到门口，咱路上接着聊。"},
        {"who":"月月","mood":"惊讶","text":"咱不就在门口吗？都站半天了。"},
        {"who":"深深","mood":"抛包袱","text":"得，告别预热结束，现在正式说再见！"}
      ]
    },
    {
      "title": "八点零三开始放松",
      "lines": [
        {"who":"月月","mood":"基础","text":"周末出去玩，我排了个特别轻松的行程。"},
        {"who":"深深","mood":"开心","text":"这好，本鲸最擅长轻松。"},
        {"who":"月月","mood":"贯口","text":"八点出门，八点零三放松，零四出发。"},
        {"who":"深深","mood":"被拆穿","text":"放松就一分钟？我肩膀还没放下来呢！"},
        {"who":"月月","mood":"基础","text":"后面有慢慢逛街，足足安排了六分钟。"},
        {"who":"深深","mood":"傲娇","text":"六分钟，我连选从哪头逛都没选明白。"},
        {"who":"月月","mood":"基础","text":"所以我替你选好了，直走，不许拐弯。"},
        {"who":"深深","mood":"抛包袱","text":"你这不叫旅游，叫给街道做长度检查。"},
        {"who":"月月","mood":"惊讶","text":"那你说，轻松的行程该怎么排？"},
        {"who":"深深","mood":"基础","text":"挑一处想去的，慢慢走，累了就坐会儿。"},
        {"who":"月月","mood":"吐槽","text":"行，我改一下。坐会儿要写几分钟？"},
        {"who":"深深","mood":"被拆穿","text":"先把你这张时间表坐住，咱再商量！"}
      ]
    },
    {
      "title": "相册的最后一张重复照片",
      "lines": [
        {"who":"深深","mood":"傲娇","text":"本鲸今天清理相册，相似照片只留一张。"},
        {"who":"月月","mood":"基础","text":"你这十二张杯子，打算留哪张？"},
        {"who":"深深","mood":"基础","text":"这张杯口亮，那张杯把正，都有优点。"},
        {"who":"月月","mood":"吐槽","text":"还有一张只有半个杯子。"},
        {"who":"深深","mood":"傲娇","text":"留白！另半个让您想象。"},
        {"who":"月月","mood":"基础","text":"那张糊成一团的呢？"},
        {"who":"深深","mood":"抛包袱","text":"那是杯子的速度，本鲸拍出了动感。"},
        {"who":"月月","mood":"吐槽","text":"杯子没动，是你打喷嚏了。"},
        {"who":"深深","mood":"被拆穿","text":"算了，我截图放一起，对比着挑。"},
        {"who":"月月","mood":"惊讶","text":"怎么又多出六张截图？"},
        {"who":"深深","mood":"基础","text":"每轮筛选得留个纪念嘛。"},
        {"who":"月月","mood":"吐槽","text":"别人清相册删照片，你清相册扩家谱。"}
      ]
    },
    {
      "title": "少许到底是哪一勺",
      "lines": [
        {"who":"深深","mood":"基础","text":"我照食谱做菜，第一步就遇上难题了。"},
        {"who":"月月","mood":"基础","text":"锅找不着，还是菜认错了？"},
        {"who":"深深","mood":"被拆穿","text":"写着盐少许。少许，咱家没这把勺啊！"},
        {"who":"月月","mood":"吐槽","text":"就是放一点，尝尝味道再说。"},
        {"who":"深深","mood":"傲娇","text":"本鲸做事讲究，你这个一点有多大？"},
        {"who":"月月","mood":"基础","text":"比一大把小，比一点没有多。"},
        {"who":"深深","mood":"抛包袱","text":"你这解释可精确，把整罐盐都包进去了。"},
        {"who":"月月","mood":"基础","text":"行，你来量，我来尝，咱俩合作。"},
        {"who":"深深","mood":"开心","text":"早说啊！来，尝这一小勺。"},
        {"who":"月月","mood":"惊讶","text":"怎么甜的？你拿的是糖！"},
        {"who":"深深","mood":"被拆穿","text":"光研究多少了，没顾上研究是谁。"},
        {"who":"月月","mood":"吐槽","text":"下回先认调料，再给少许办户口。"}
      ]
    }
  ],
  "templates": {
    "giftSmall": [
      {
        "who": "深深",
        "mood": "谢礼物",
        "text": "谢谢{user}送的{gift}！……咳，本鲸才没有很开心，只是今天干活儿倍儿有劲儿而已！"
      },
      {
        "who": "深深",
        "mood": "谢礼物",
        "text": "哇，{user}的{gift}！得嘞，这份心意本鲸收下了！"
      },
      {
        "who": "月月",
        "mood": "谢礼物",
        "text": "谢谢{user}的{gift}。深深已经开始偷着乐了，我替她说一声谢谢。"
      }
    ],
    "giftBig": [
      {
        "who": "深深",
        "mood": "谢礼物",
        "text": "哇！{user}送了{count}个{gift}！……咳，本鲸很镇定，一点都不激动！"
      },
      {
        "who": "月月",
        "mood": "谢礼物",
        "text": "谢谢{user}，这份心意我们记住了。深深，嘴角收一收。"
      }
    ],
