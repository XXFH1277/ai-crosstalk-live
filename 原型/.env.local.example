# 复制本文件为 .env.local，填上 key（不要加引号也可以）。.env.local 里的值优先于系统环境变量。
# 中转站地址和模型名在 config.json 的 providers 里改。.env.local 永远不要提交或外传。

# 中转站（OpenAI 兼容）：深深 / 月月 / 豆姐各用一个 key，也可以填同一个
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DOUBAO_API_KEY=
# 小克（Claude 娘）的中转 key；没填就借深深的
CLAUDE_API_KEY=
# 导演编排和弹幕审核单独用的中转 key（避免和角色抢同一个 key）；没填就借深深的
PLANNER_API_KEY=

# 官方备用接口：中转站报错、超时或过慢时，那一句改走官方（见 节目与等待说明.md）
DEEPSEEK_OFFICIAL_API_KEY=
VOLC_API_KEY=

# douyinLive 本地服务的访问密钥（和 工具/douyinLive-v2.3.2/app/config.yaml 里的 api.key 一致）
DOUYINLIVE_KEY=
